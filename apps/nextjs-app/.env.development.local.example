#######################################################################################
# teable-desktop local overrides — zero-container mode (no Docker / Redis / Postgres) #
# This file shadows .env.development (dotenv-flow: .env.development.local wins).      #
#######################################################################################

# ---- Database: PGlite wire bridge (run `pnpm pglite:bridge` first) ------------------
# PGlite is a single Postgres session and the pglite-socket multiplexer cannot
# safely interleave the extended protocol (Parse/Bind/Execute portals) of several
# client connections — concurrent queries on two connections either hang behind an
# open transaction or fail with `portal "" does not exist` (34000).
#
# connection_limit=1 → exactly one wire connection: every query serializes on it,
#                      which is precisely PGlite's single-session reality.
#                      Requires in-transaction engine queries to route through the
#                      CLS transaction client (prismaService.txClient()) — queries
#                      that go to the pool from inside a transaction would wait for
#                      the very connection the transaction holds.
# DATABASE_POOL_IDLE_TIMEOUT_MS=0 → never close the pooled connection when idle; the
#                      multiplexer can drop a handshake that races with active
#                      queries, so the connection must never be re-established at
#                      request time.
# statement_cache_size=0 avoids cached-plan invalidation errors after DDL (same as tests).
PRISMA_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5544/teable?schema=public&connection_limit=1&statement_cache_size=0
DATABASE_POOL_IDLE_TIMEOUT_MS=0

# ---- Redis: none --------------------------------------------------------------------
# Empty value = no Redis. Cache falls back to sqlite (.assets/.cache.db), job queues
# fall back to the in-process local queue, BullMQ root is not registered, and the
# computed-outbox wakeup transport runs its in-process publisher.
BACKEND_CACHE_REDIS_URI=
BACKEND_CACHE_PROVIDER=sqlite

# ---- Attachments: local disk (default, explicit for clarity) ------------------------
BACKEND_STORAGE_PROVIDER=local

# ---- BYODB machinery off (SaaS feature, slated for removal in the desktop cut) ------
# Its migration worker retries with zero delay when it keeps finding work, which
# monopolizes the single PGlite pool connection and starves HTTP requests.
BYODB_SPACE_DATA_DB_MIGRATION_WORKER_ENABLED=false

# ---- Informational BYODB proxy host:port (nothing dials it; keep it pointing at bridge)
PUBLIC_DATABASE_PROXY=127.0.0.1:5544

# ---- Silence dev OTel export attempts (no collector running locally) ----------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# ---- Bring-up diagnostics (optional) ------------------------------------------------
# PG_POOL_DEBUG=1  # log pg pool acquire/release + prisma adapter queries to console
